# ML settings are read ONLY on the server. Restart Next.js after changing them.
ML_PROVIDER=mock
ML_TIMEOUT_MS=60000
# http mode: full inference URL; receives multipart audio/requestId/stationId.
AI_CLASSIFICATION_ENDPOINT=
AI_CLASSIFICATION_API_KEY=

# Data and Telegram remain browser-only demos; placeholders below are not wired.
NEXT_PUBLIC_DATA_MODE=demo
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

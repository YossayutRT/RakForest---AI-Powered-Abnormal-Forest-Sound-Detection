# Supabase Configuration (Base Project URL without /rest/v1/)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Telegram Bot Alert Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Local FastAPI AudioCNN Endpoint (falls back automatically if Python server is not running)
ML_PROVIDER=http
ML_TIMEOUT_MS=60000
AI_CLASSIFICATION_ENDPOINT=http://127.0.0.1:8000/analyze
AI_CLASSIFICATION_API_KEY=

# Map Tile URL
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
